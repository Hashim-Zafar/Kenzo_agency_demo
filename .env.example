# Server-only. Never prefix these with NEXT_PUBLIC_: the browser must not see them.

# Where the Kenzo API runs (no trailing slash)
KENZO_API_URL=http://localhost:8000

# The demo agency's row in the database
KENZO_DEMO_AGENCY_ID=
KENZO_DEMO_SCHEMA=

# Optional in development (the API doesn't check it there either).
# Required in production: the same value as the API's KENZO_INTERNAL_TOKEN.
# Make one with: openssl rand -hex 32
KENZO_INTERNAL_TOKEN=

# Optional. Demo visitors get made-up emails on this domain; nothing is ever
# sent. Defaults to demo.example.com (reserved, can't belong to anyone).
# KENZO_DEMO_EMAIL_DOMAIN=

# ---- Sentry (errors only; leave empty to switch it off) ----
# Public by design (it can only send events). Same value for browser and server.
NEXT_PUBLIC_SENTRY_DSN=
# Optional label, e.g. demo, staging, production. Defaults to NODE_ENV.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional, for readable stack traces: set these where you build/deploy.
# SENTRY_AUTH_TOKEN is a secret: never commit it, never prefix it NEXT_PUBLIC_.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Prints what the Sentry SDK does to the server log while you debug.
# SENTRY_DEBUG=1
